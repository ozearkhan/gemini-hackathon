# ─────────────────────────────────────────────────────────────────────────────
# EPAM Hackathon — Team Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in YOUR team's values.
# .env is loaded by: source .env && ./deploy.sh [mode]
# ─────────────────────────────────────────────────────────────────────────────

# ⚠️  REQUIRED — Your GCP sandbox project ID (Layer 2)
# Get this from your hackathon support team or GCP Console
GOOGLE_CLOUD_PROJECT=your-sandbox-project-id

# GCP region — keep as us-central1 for the hackathon
GOOGLE_CLOUD_LOCATION=us-central1

# ── Optional overrides ────────────────────────────────────────────────────────

# Cloud Run service name (default: epam-hackathon-demo)
# CLOUD_RUN_SERVICE_NAME=my-team-agent

# GCS staging bucket for Agent Engine deployments
# Default: gs://[your-project-id]-staging  (ADK creates this automatically)
# STAGING_BUCKET=gs://my-custom-bucket
